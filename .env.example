# Four Us — Environment Configuration
# Copy this file to .env and fill in with your Firebase project credentials.
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app config

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=four-us-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=four-us-app
VITE_FIREBASE_STORAGE_BUCKET=four-us-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Set to 'true' to connect to local Firebase emulators during development:
VITE_USE_EMULATORS=false
